<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 股票行情：腾讯 qt.gtimg.cn；同步：自己的 API 服务器（发布版只走 https） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内更新：把下载好的 apk 交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PotApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.Stockpot"
        android:enableOnBackInvokedCallback="true">

        <!--
            应用内更新：把自己下载的 apk 通过 FileProvider 交给系统安装器。
            exported=false + 只放出 updates/ 目录，别的应用拿不到这里的东西。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            桌面入口全部交给下面的 activity-alias：一种图标样式（× 是否加圆形遮罩）一个入口，
            设置里切换时用 PackageManager 开关对应别名。MainActivity 自己不再挂 LAUNCHER，
            否则会永远多出一个关不掉的图标。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|layoutDirection|screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize">

            <!-- 在微信 / 支付宝 / 文件管理器里直接分享账单进来 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>

            <!-- 长按图标那几个快捷方式。定义放在 res/xml/shortcuts.xml -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 朱砂（默认） -->
        <activity-alias
            android:name=".LauncherCinnabar"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cinnabar"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cinnabar"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherCinnabarMask"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cinnabar_mask"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cinnabar_mask"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 墨 -->
        <activity-alias
            android:name=".LauncherInk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherInkMask"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink_mask"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ink_mask"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 米白 -->
        <activity-alias
            android:name=".LauncherCream"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cream"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cream"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherCreamMask"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cream_mask"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cream_mask"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 松绿 -->
        <activity-alias
            android:name=".LauncherPine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pine"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pine"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherPineMask"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pine_mask"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_pine_mask"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <!--
            桌面小组件。两张卡都是「画一张图塞进 ImageView」：
            字体、字距、迷你柱都由代码控制，格子变了就按新尺寸重画。
        -->
        <receiver
            android:name=".widget.MonthWidgetProvider"
            android:exported="false"
            android:label="@string/widget_month_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RecentWidgetProvider"
            android:exported="false"
            android:label="@string/widget_recent_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>
    </application>
</manifest>
